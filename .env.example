# Copy this file to ~/.termihub.env and fill in your real values.
# start.sh will source it automatically.
# Never commit the real .termihub.env to version control.

# Token from @BotFather on Telegram
TERMIHUB_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID — find it by messaging @userinfobot
# Multiple IDs: "111111111,222222222"
TERMIHUB_ALLOWED_IDS=123456789

# Optional — seconds before a shell command is killed (default: 10)
# TERMIHUB_CMD_TIMEOUT=10

# Optional — name used in greeting messages (default: TermiHub)
# TERMIHUB_BOT_NAME=TermiHub
